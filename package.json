{
  "name": "pagewise",
  "version": "0.0.4",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "lint": "eslint . --ext .js,.cjs,.ts,.tsx --max-warnings 0",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test -- --runInBand",
    "android:build": "cd android && ./gradlew :app:assembleDebug",
    "math:assets": "node scripts/copy-mathjax.js",
    "postinstall": "npm run math:assets",
    "preandroid": "npm run math:assets",
    "preandroid:build": "npm run math:assets",
    "eval:live": "node scripts/eval-live.cjs"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@op-engineering/op-sqlite": "18.2.5",
    "@react-native-community/blur": "4.4.1",
    "@react-native-documents/picker": "12.0.3",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "htmlparser2": "10.0.0",
    "lucide-react-native": "1.63.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-blob-util": "0.25.1",
    "react-native-gesture-handler": "2.33.1",
    "react-native-keychain": "10.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "react-native-zip-archive": "9.5.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "5.0.2",
    "eslint": "^8.19.0",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "jest": "^29.6.3",
    "mathjax": "3.2.2",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "license": "GPL-3.0-only",
  "op-sqlite": {
    "fts5": true
  },
  "codegenConfig": {
    "name": "PagewiseSpec",
    "type": "modules",
    "jsSrcsDir": "src/platform/specs",
    "android": {
      "javaPackageName": "com.pagewise.specs"
    }
  }
}
