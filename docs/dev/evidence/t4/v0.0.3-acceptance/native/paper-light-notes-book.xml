e="false" focused="false" a11y-focused="false" /><node text="哲学、数学、经济学、神经科学、心理学、计算机工程、控制论和语言学分别为 AI 提供了问题和工具。" content-desc="" class="android.widget.TextView" bounds="[42,799][1238,921]" clickable="false" focused="false" a11y-focused="false" /><node text="" content-desc="1.3 人工智能的历史" class="android.widget.Button" bounds="[0,960][1280,1229]" clickable="true" focused="false" a11y-focused="false" /><node text="1.3 人工智能的历史" content-desc="" class="android.widget.TextView" bounds="[42,996][1118,1059]" clickable="false" focused="false" a11y-focused="false" /><node text="" content-desc="已学" class="android.widget.TextView" bounds="[1142,996][1238,1058]" clickable="false" focused="false" a11y-focused="false" /><node text="已学" content-desc="" class="android.widget.TextView" bounds="[1157,1002][1223,1052]" clickable="false" focused="false" a11y-focused="false" /><node text="从 1943 年的神经元模型到深度学习，AI 经历了几轮乐观、寒冬和复兴。" content-desc="" class="android.widget.TextView" bounds="[42,1068][1238,1190]" clickable="false" focused="false" a11y-focused="false" /><node text="" content-desc="1.4 目前的先进技术" class="android.widget.Button" bounds="[0,1229][1280,1498]" clickable="true" focused="false" a11y-focused="false" /><node text="1.4 目前的先进技术" content-desc="" class="android.widget.TextView" bounds="[42,1265][1118,1328]" clickable="false" focused="false" a11y-focused="false" /><node text="" content-desc="已学" class="android.widget.TextView" bounds="[1142,1265][1238,1327]" clickable="false" focused="false" a11y-focused="false" /><node text="已学" content-desc="" class="android.widget.TextView" bounds="[1157,1271][1223,1321]" clickable="false" focused="false" a11y-focused="false" /><node text="列举了机器人、语音识别、博弈、医疗、气候等领域当前能做到的事。" content-desc="" class="android.widget.TextView" bounds="[42,1337][1238,1459]" clickable="false" focused="false" a11y-focused="false" /><node text="" content-desc="1.5 人工智能的风险和收益" class="android.widget.Button" bounds="[0,1498][1280,1767]" clickable="true" focused="false" a11y-focused=