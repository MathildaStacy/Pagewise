tView" bounds="[42,2218][1118,2281]" clickable="false" focused="false" a11y-focused="false" /><node text="" content-desc="已学" class="android.widget.TextView" bounds="[1142,2218][1238,2280]" clickable="false" focused="false" a11y-focused="false" /><node text="已学" content-desc="" class="android.widget.TextView" bounds="[1157,2224][1223,2274]" clickable="false" focused="false" a11y-focused="false" /><node text="理性指在已有感知和先验知识下，选择期望性能度量最大的动作；用 PEAS 描述任务环境。" content-desc="" class="android.widget.TextView" bounds="[42,2290][1238,2412]" clickable="false" focused="false" a11y-focused="false" /><node text="" content-desc="2.3 环境的本质" class="android.widget.Button" bounds="[0,2451][1280,2720]" clickable="true" focused="false" a11y-focused="false" /><node text="2.3 环境的本质" content-desc="" class="android.widget.TextView" bounds="[42,2487][1118,2550]" clickable="false" focused="false" a11y-focused="false" /><node text="" content-desc="已学" class="android.widget.TextView" bounds="[1142,2487][1238,2549]" clickable="false" focused="false" a11y-focused="false" /><node text="已学" content-desc="" class="android.widget.TextView" bounds="[1157,2493][1223,2543]" clickable="false" focused="false" a11y-focused="false" /><node text="任务环境按可观测性、智能体数量、确定性、片段性、静态性、离散性、已知性分类。" content-desc="" class="android.widget.TextView" bounds="[42,2559][1238,2681]" clickable="false" focused="false" a11y-focused="false" /><node text="" content-desc="2.4 智能体的结构" class="android.widget.Button" bounds="[0,2720][1280,2784]" clickable="true" focused="false" a11y-focused="false" /><node text="2.4 智能体的结构" content-desc="" class="android.widget.TextView" bounds="[42,2756][1118,2784]" clickable="false" focused="false" a11y-focused="false" /><node text="" content-desc="已学" class="android.widget.TextView" bounds="[1142,2756][1238,2784]" clickable="false" focused="false" a11y-focused="false" /><node text="已学" content-desc="" class="android.widget.TextView" bounds="[1157,2762][1223,2784]" clickable="false" focused="false" a11y-f