{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@core/*": ["./src/core/*"],
      "@data/*": ["./src/data/*"],
      "@services/*": ["./src/services/*"],
      "@platform/*": ["./src/platform/*"],
      "@app/*": ["./src/app/*"],
      "@features/*": ["./src/features/*"],
      "@ui/*": ["./src/ui/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": ["node_modules", "android", "docs"]
}
